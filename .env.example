# Copy this file to `.env` before running `docker compose up`:
#
#   cp .env.example .env
#
# Only the web service reads this file (via `env_file` in compose.yaml).

# Brevo transactional email for incident notifications. When set, incident emails
# are delivered for real; when empty, they fall back to the development mailbox
# at http://localhost:4000/dev/mailbox (Swoosh.Adapters.Local).
BREVO_API_KEY=

# Sender shown on incident emails. The address must be verified in Brevo for
# real delivery.
MAILER_FROM=contact@example.com
MAILER_FROM_NAME=PulseOps