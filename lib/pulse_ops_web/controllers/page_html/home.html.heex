<Layouts.public flash={@flash} current_scope={@current_scope}>
  <%!-- Hero: what it is and a way in on the left, the product itself on the right. --%>
  <section class="grid items-center gap-10 py-6 sm:py-12 lg:grid-cols-2 lg:gap-12">
    <div class="text-center lg:text-left">
      <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-base-300 bg-base-100 px-3 py-1 text-xs text-base-content/60">
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full rounded-full bg-success opacity-60 motion-safe:animate-ping"></span>
          <span class="relative inline-flex size-2 rounded-full bg-success"></span>
        </span>
        Real-time monitoring, built on Elixir and OTP
      </p>

      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl lg:text-[3.25rem] lg:leading-[1.1]">
        Know a service is down before somebody tells you
      </h1>

      <p class="mx-auto mt-5 max-w-xl text-lg text-base-content/70 lg:mx-0">
        PulseOps watches every service you register from its own supervised process, tells a real
        outage from a brief blip, opens the incident on its own and tells your team. Your dashboard
        updates the moment it happens.
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-3 lg:justify-start">
        <.button navigate={~p"/users/register"} variant="primary">
          Start monitoring <.icon name="lucide-arrow-right" class="size-4" />
        </.button>
        <.button navigate={~p"/users/log-in"} variant="ghost">I already have an account</.button>
      </div>

      <p class="mt-4 text-xs text-base-content/50">
        Sign up with just an email.
        <a href={github_url()} class="link link-hover" rel="noopener">Read the source on GitHub</a>
      </p>
    </div>

    <.product_preview />
  </section>

  <%!-- Facts, each one checkable in the product or the code. --%>
  <section aria-label="At a glance" class="py-6">
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <li
        :for={fact <- facts()}
        class="flex items-start gap-3 rounded-box border border-base-300 bg-base-100 p-4"
      >
        <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
          <.icon name={fact.icon} class="size-5" />
        </span>
        <div class="min-w-0">
          <p class="font-medium">{fact.title}</p>
          <p class="text-sm text-base-content/60">{fact.body}</p>
        </div>
      </li>
    </ul>
  </section>

  <section id="features" aria-labelledby="features-title" class="py-12 sm:py-16">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="features-title" class="text-3xl font-semibold tracking-tight">
        Everything between "is it up?" and "who is on it?"
      </h2>
      <p class="mt-3 text-base-content/70">
        Checks, incidents, paging and a page for your customers — in one place, without an agent to
        install.
      </p>
    </div>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <li
        :for={feature <- features()}
        class="rounded-box border border-base-300 bg-base-100 p-5 transition-colors hover:border-base-content/20"
      >
        <span class="flex size-9 items-center justify-center rounded-lg bg-primary/10 text-primary">
          <.icon name={feature.icon} class="size-5" />
        </span>
        <h3 class="mt-3 font-medium">{feature.title}</h3>
        <p class="mt-1 text-sm text-base-content/60">{feature.body}</p>
      </li>
    </ul>
  </section>

  <section
    id="status-page"
    aria-labelledby="status-page-title"
    class="grid items-center gap-8 rounded-box border border-base-300 bg-base-100 p-6 sm:p-10 lg:grid-cols-2"
  >
    <div>
      <p class="text-sm font-medium text-primary">For your customers</p>
      <h2 id="status-page-title" class="mt-1 text-2xl font-semibold tracking-tight">
        A status page that updates itself
      </h2>
      <p class="mt-3 text-base-content/70">
        Publish one page anybody can read without an account, live over the same connection the
        dashboard uses. Planned maintenance is shown as planned, not as an outage.
      </p>
      <ul class="mt-4 space-y-2 text-sm text-base-content/70">
        <li class="flex gap-2">
          <.icon name="lucide-check" class="mt-0.5 size-4 shrink-0 text-success" />
          Service names, status and uptime — never URLs, causes or timelines
        </li>
        <li class="flex gap-2">
          <.icon name="lucide-check" class="mt-0.5 size-4 shrink-0 text-success" />
          Choose which services appear, one checkbox each
        </li>
        <li class="flex gap-2">
          <.icon name="lucide-check" class="mt-0.5 size-4 shrink-0 text-success" />
          Unpublished looks exactly like it does not exist
        </li>
      </ul>
    </div>

    <%!-- Decorative, like the dashboard preview: the list beside it says the same. --%>
    <div aria-hidden="true" class="rounded-box border border-base-300 bg-base-200/60 p-4 sm:p-5">
      <p class="font-semibold">Acme</p>
      <div class="mt-3 flex items-center gap-3 rounded-box border border-success/40 bg-success/5 p-3 text-success">
        <.icon name="lucide-circle-check" class="size-5 shrink-0" />
        <p class="text-sm font-medium">All systems operational</p>
      </div>
      <ul class="mt-3 divide-y divide-base-300 rounded-box border border-base-300 bg-base-100">
        <li :for={service <- status_page_services()} class="flex items-center gap-3 px-3 py-2.5">
          <span class="min-w-0 flex-1 truncate text-sm font-medium">{service.name}</span>
          <span class="text-xs tabular-nums text-base-content/50">{service.uptime}</span>
          <.status_badge status={service.status} class="text-sm" />
        </li>
      </ul>
    </div>
  </section>

  <section id="how-it-works" class="py-12 sm:py-16">
    <div class="mx-auto mb-8 max-w-2xl text-center">
      <p class="text-sm font-medium text-primary">For the engineers</p>
      <h2 class="mt-1 text-3xl font-semibold tracking-tight">How it works inside</h2>
      <p class="mt-3 text-base-content/70">
        Health checks are driven by long-lived OTP processes, not by requests. The web layer only
        reads state and listens for changes.
      </p>
    </div>

    <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-base-content/60">
      What happens on every check
    </h3>

    <figure class="flow-diagram rounded-box border border-base-300 bg-base-100 p-4">
      <style>
        /* Built from the theme's own colours, so it follows light and dark with
           the rest of the page instead of keeping a palette of its own. */
        .flow-diagram {
          --flow-node: var(--color-base-100);
          --flow-border: var(--color-base-300);
          --flow-ink: var(--color-base-content);
          --flow-muted: color-mix(in oklab, var(--color-base-content) 55%, transparent);
          --flow-edge: color-mix(in oklab, var(--color-base-content) 35%, transparent);
          --flow-accent: var(--color-primary);
        }

        /* A travelling dash is what an "animated" edge in a node graph actually
           is. 6 + 8 = 14, so the offset loops seamlessly. */
        .flow-edge {
          fill: none;
          stroke-width: 1.5;
          stroke-dasharray: 6 8;
          animation: flow-dash 1.1s linear infinite;
        }
        @keyframes flow-dash {
          to { stroke-dashoffset: -14; }
        }

        .flow-pulse {
          animation: flow-pulse 2.4s ease-in-out infinite;
        }
        @keyframes flow-pulse {
          0%, 100% { opacity: 0.3; }
          50% { opacity: 1; }
        }

        @media (prefers-reduced-motion: reduce) {
          .flow-edge, .flow-pulse { animation: none; }
          .flow-edge { stroke-dasharray: none; }
        }
      </style>

      <%!-- Too wide to read on a phone, where the steps below are shown instead. --%>
      <div class="overflow-x-auto max-sm:hidden">
        <svg
          viewBox="0 0 880 452"
          class="h-auto w-full min-w-[760px]"
          role="img"
          aria-label="A jittered timer starts a supervised task, which probes your endpoint over HTTP; the result comes back to the monitor as a message. Every check is recorded and pushed to that service's own page. The monitor then asks whether the status changed. If it did, the new status is saved and broadcast to the dashboard and the status page, and if the service went down or recovered, an incident is opened or resolved and broadcast too. If it did not, no status is broadcast."
        >
          <defs>
            <marker
              id="flow-arrow"
              viewBox="0 0 10 10"
              refX="9"
              refY="5"
              markerWidth="5"
              markerHeight="5"
              orient="auto-start-reverse"
            >
              <path d="M0,0 L10,5 L0,10 z" fill="var(--flow-edge)" />
            </marker>
            <marker
              id="flow-arrow-accent"
              viewBox="0 0 10 10"
              refX="9"
              refY="5"
              markerWidth="5"
              markerHeight="5"
              orient="auto-start-reverse"
            >
              <path d="M0,0 L10,5 L0,10 z" fill="var(--flow-accent)" />
            </marker>
          </defs>

          <%!-- What happens on every single probe: neutral. --%>
          <g stroke="var(--flow-edge)" marker-end="url(#flow-arrow)">
            <path class="flow-edge" d="M184,65 L222,65" />
            <path class="flow-edge" d="M420,65 L458,65" />
            <path class="flow-edge" d="M632,65 L670,65" />
            <path class="flow-edge" d="M770,94 L770,144" />
            <path class="flow-edge" d="M676,179 L638,179" />
            <path class="flow-edge" d="M770,208 L770,258" />
          </g>

          <%!-- What only happens when the status changed carries the colour,
                because that is the part worth noticing. --%>
          <g stroke="var(--flow-accent)" marker-end="url(#flow-arrow-accent)">
            <path class="flow-edge" d="M676,293 L638,293" />
            <path class="flow-edge" d="M464,293 L426,293" />
            <path class="flow-edge" d="M548,322 L548,372" />
            <path class="flow-edge" d="M438,407 L334,407 Q324,407 324,397 L324,328" />
          </g>

          <g font-size="13" font-weight="600" fill="var(--flow-ink)">
            <%!-- Row 1: the probe --%>
            <g>
              <rect
                x="16"
                y="36"
                width="168"
                height="58"
                rx="10"
                fill="var(--flow-node)"
                stroke="var(--flow-border)"
              />
              <text x="100" y="61" text-anchor="middle">Jittered timer</text>
              <text
                x="100"
                y="79"
                text-anchor="middle"
                font-size="11"
                font-weight="400"
                fill="var(--flow-muted)"
                font-family="ui-monospace, monospace"
              >
                send_after
              </text>
            </g>

            <g>
              <rect
                x="228"
                y="36"
                width="192"
                height="58"
                rx="10"
                fill="var(--flow-node)"
                stroke="var(--flow-border)"
              />
              <text x="324" y="61" text-anchor="middle">Supervised task</text>
              <text
                x="324"
                y="79"
                text-anchor="middle"
                font-size="11"
                font-weight="400"
                fill="var(--flow-muted)"
                font-family="ui-monospace, monospace"
              >
                async_nolink
              </text>
            </g>

            <g>
              <rect
                x="464"
                y="36"
                width="168"
                height="58"
                rx="10"
                fill="var(--flow-node)"
                stroke="var(--flow-border)"
              />
              <circle class="flow-pulse" cx="484" cy="52" r="3.5" fill="var(--flow-accent)" />
              <text x="556" y="61" text-anchor="middle">Your endpoint</text>
              <text
                x="556"
                y="79"
                text-anchor="middle"
                font-size="11"
                font-weight="400"
                fill="var(--flow-muted)"
              >
                one HTTP probe
              </text>
            </g>

            <g>
              <rect
                x="676"
                y="36"
                width="188"
                height="58"
                rx="10"
                fill="var(--flow-node)"
                stroke="var(--flow-border)"
              />
              <text x="770" y="61" text-anchor="middle">Monitor</text>
              <text
                x="770"
                y="79"
                text-anchor="middle"
                font-size="11"
                font-weight="400"
                fill="var(--flow-muted)"
                font-family="ui-monospace, monospace"
              >
                handle_info
              </text>
            </g>

            <%!-- Row 2: every check --%>
            <g>
              <rect
                x="676"
                y="150"
                width="188"
                height="58"
                rx="10"
                fill="var(--flow-node)"
                stroke="var(--flow-border)"
              />
              <text x="770" y="175" text-anchor="middle">Record the check</text>
              <text
                x="770"
                y="193"
                text-anchor="middle"
                font-size="11"
                font-weight="400"
                fill="var(--flow-muted)"
              >
                every single probe
              </text>
            </g>

            <g>
              <rect
                x="464"
                y="150"
                width="168"
                height="58"
                rx="10"
                fill="var(--flow-node)"
                stroke="var(--flow-border)"
              />
              <text x="548" y="175" text-anchor="middle">Service page</text>
              <text
                x="548"
                y="193"
                text-anchor="middle"
                font-size="11"
                font-weight="400"
                fill="var(--flow-muted)"
              >
                sees every check live
              </text>
            </g>

            <%!-- Row 3: the decision, and what a change sets off --%>
            <g>
              <rect
                x="676"
                y="264"
                width="188"
                height="58"
                rx="10"
                fill="var(--flow-node)"
                stroke="var(--flow-border)"
                stroke-dasharray="4 3"
              />
              <text x="770" y="289" text-anchor="middle">Status changed?</text>
              <text
                x="770"
                y="307"
                text-anchor="middle"
                font-size="11"
                font-weight="400"
                fill="var(--flow-muted)"
              >
                new status vs. the last one
              </text>
            </g>

            <g>
              <rect
                x="464"
                y="264"
                width="168"
                height="58"
                rx="10"
                fill="var(--flow-node)"
                stroke="var(--flow-accent)"
              />
              <text x="548" y="289" text-anchor="middle">Update the status</text>
              <text
                x="548"
                y="307"
                text-anchor="middle"
                font-size="11"
                font-weight="400"
                fill="var(--flow-muted)"
              >
                saved and broadcast
              </text>
            </g>

            <g>
              <rect
                x="228"
                y="264"
                width="192"
                height="58"
                rx="10"
                fill="var(--flow-node)"
                stroke="var(--flow-accent)"
              />
              <text x="324" y="289" text-anchor="middle">Dashboard, status page</text>
              <text
                x="324"
                y="307"
                text-anchor="middle"
                font-size="11"
                font-weight="400"
                fill="var(--flow-muted)"
              >
                over the socket
              </text>
            </g>

            <%!-- Row 4: incidents follow only two of the possible changes --%>
            <g>
              <rect
                x="438"
                y="378"
                width="220"
                height="58"
                rx="10"
                fill="var(--flow-node)"
                stroke="var(--flow-accent)"
              />
              <text x="548" y="403" text-anchor="middle">Open or resolve an incident</text>
              <text
                x="548"
                y="421"
                text-anchor="middle"
                font-size="11"
                font-weight="400"
                fill="var(--flow-muted)"
              >
                only on going down or recovering
              </text>
            </g>
          </g>

          <g font-size="11" fill="var(--flow-muted)">
            <text x="760" y="124" text-anchor="end">the result, as a message</text>
            <text x="657" y="286" text-anchor="middle" fill="var(--flow-accent)" font-weight="600">
              yes
            </text>
            <text x="770" y="342" text-anchor="middle">no: no status is broadcast</text>
          </g>
        </svg>
      </div>

      <figcaption class="mt-3 text-sm text-base-content/60">
        The probe never runs inside the process's own callback. A monitor has one mailbox, and a
        request with a five second timeout would block it for five seconds — unable to answer, be
        reconfigured, or shut down cleanly.
      </figcaption>

      <details class="mt-2 max-sm:hidden">
        <summary class="cursor-pointer text-xs text-base-content/50">Read it as steps</summary>
        <.check_steps class="mt-2" />
      </details>

      <.check_steps class="mt-4 sm:hidden" />
    </figure>

    <ul class="mt-6 grid gap-4 md:grid-cols-3">
      <li
        :for={decision <- decisions()}
        class="rounded-box border border-base-300 bg-base-100 p-5"
      >
        <h4 class="font-medium">{decision.title}</h4>
        <p class="mt-1 text-sm text-base-content/60">{decision.body}</p>
      </li>
    </ul>
  </section>

  <section class="mb-6 rounded-box bg-primary px-6 py-10 text-center text-primary-content sm:py-14">
    <h2 class="text-3xl font-semibold tracking-tight">Start watching your first service</h2>
    <p class="mx-auto mt-3 max-w-xl opacity-80">
      Register with an email, add a URL, press "Test connection". The first check runs straight
      away.
    </p>
    <div class="mt-7 flex flex-wrap justify-center gap-3">
      <.button
        navigate={~p"/users/register"}
        class="border-0 bg-base-100 text-base-content hover:bg-base-200"
      >
        Start monitoring <.icon name="lucide-arrow-right" class="size-4" />
      </.button>
      <a
        href={github_url()}
        rel="noopener"
        class="btn btn-ghost text-primary-content hover:bg-primary-content/10"
      >
        <.icon name="lucide-code" class="size-4" /> View the source
      </a>
    </div>
  </section>
</Layouts.public>
